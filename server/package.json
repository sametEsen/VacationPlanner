{
  "name": "vacation-planner-server",
  "version": "1.0.0",
  "description": "Vacation Planner — Node.js/Express backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "dev:reset": "dev-reset.cmd",
    "build": "tsc",
    "start": "node dist/app.js",
    "seed": "ts-node src/seed.ts",
    "auth:bootstrap": "ts-node src/scripts/bootstrap-passwords.ts",
    "test": "npm run build && node --test tests/auth.test.cjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "mongoose": "^8.0.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.14",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
